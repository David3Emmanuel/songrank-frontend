# The address this deployment lives at. Optional: without it a share card says
# only "SongRank", and link previews use whatever host serves the page.
NEXT_PUBLIC_SITE_URL=

# YouTube Data API v3 key, read by the server for playlist imports and for
# filling in lengths and artist names that YouTube Music leaves out. Search does
# not need it. Optional, but imports cannot run without it.
# Get yours at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Supabase (optional - duels work in mock mode without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
